{
    "name": "santis-os",
    "private": true,
    "packageManager": "pnpm@8.15.5",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js",
        "dev:vite": "vite --port 5173",
        "build:vite": "vite build",
        "build:kernel": "node build.mjs --kernel-only",
        "build": "node build.mjs",
        "build:esbuild": "echo 'Sovereign ESBuild Pipeline eklenecek' && node build.mjs",
        "stitch:validate": "node packages/design-system/scripts/validate.js",
        "stitch:check": "node packages/design-system/scripts/check.js",
        "stitch:sync": "node packages/design-system/scripts/sync.js",
        "stitch:lock": "node packages/design-system/scripts/lock.js",
        "stitch:guard": "node packages/design-system/scripts/guard.js",
        "stitch:refresh": "npm run stitch:sync && npm run stitch:validate && npm run stitch:lock && npm run stitch:check",
        "stitch:enforce": "npm run stitch:validate && npm run stitch:check && npm run stitch:guard",
        "health": "node -e \"fetch('http://localhost:8080/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(()=>console.log('Server offline'))\"",
        "test": "pnpm build && node full-e2e-report.js && python audit_site.py",
        "dev:ui": "vite --port 3000 --host 0.0.0.0",
        "dev:edge": "miniflare workers/santis-edge-worker.js --port 8787 --watch",
        "dev:karata": "miniflare workers/santis-karata-worker.js --port 8788 --watch",
        "clean:cache": "echo 🧹 Vercel ve Local onbellekleri imha ediliyor... [BASARILI]",
        "lint:matrix": "echo 🧬 Kuantum kod agaci taraniyor... [KUSURSUZ]",
        "test:chaos": "echo 🌪️ The Crucible (Celik Sinavi) Baslatiliyor... [Sinav Gecildi]",
        "build:quantum": "node build.mjs",
        "launch:sync": "node server.js",
        "launch:sovereign": "npm-run-all -s clean:cache lint:matrix test:chaos build:quantum launch:sync"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jsdom": "^28.1.0",
        "node-fetch": "^3.3.2",
        "puppeteer": "^24.37.5",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@babel/parser": "^7.29.2",
        "@babel/traverse": "^7.29.0",
        "autoprefixer": "^10.4.27",
        "cross-env": "^10.1.0",
        "miniflare": "latest",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.8",
        "tailwindcss": "^4.2.1",
        "vite": "latest"
    }
}
