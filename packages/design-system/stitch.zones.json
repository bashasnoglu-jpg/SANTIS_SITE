{
  "version": 2,
  "zones": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/coverage/**",
      "**/.git/**",
      "**/.vercel/**"
    ],
    "chartConfig": [
      "**/*Chart.js",
      "**/*Chart.jsx",
      "**/*Chart.ts",
      "**/*Chart.tsx"
    ],
    "fxAllowed": [
      "**/components/dashboard/GodsEye.jsx",
      "**/components/dashboard/LongevityMatrix.jsx",
      "**/components/dashboard/SantisBoardroom.jsx",
      "**/pages/Concierge.jsx"
    ],
    "layoutAllowed": [
      "**/components/dashboard/SantisBoardroom.jsx",
      "**/boardroom/BoardroomView.tsx",
      "**/components/boardroom/ActionDecisionDrawer.jsx",
      "**/pages/Concierge.jsx",
      "**/pages/Operations.jsx"
    ],
    "strict": [
      "**/admin-panel/**",
      "**/components/**",
      "**/pages/**",
      "**/src/**",
      "**/assets/js/**",
      "**/assets/css/**",
      "**/tr/**/*.html",
      "**/*.tsx",
      "**/*.jsx",
      "**/*.ts",
      "**/*.js",
      "**/*.css",
      "**/*.html"
    ]
  }
}
