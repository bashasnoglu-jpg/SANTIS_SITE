{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@santis/domain-contracts/*": ["packages/domain-contracts/src/*"],
            "@santis/domain-runtime/*": ["packages/domain-runtime/src/*"]
        }
    },
    "ts-node": {
        "esm": true
    }
}
