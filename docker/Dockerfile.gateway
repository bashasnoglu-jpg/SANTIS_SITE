# ╔══════════════════════════════════════════════════════╗
# ║  SANTIS OS — Unified Reverse-Proxy Gateway          ║
# ║  Nginx Edge Server routing all microservices        ║
# ╚══════════════════════════════════════════════════════╝

FROM nginx:1.27-alpine

# Copy unified routing gateway configuration
COPY docker/gateway.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
