{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Santis OS — API Performansı, BullMQ Kuyruğu, Redis & Nginx",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 FastAPI Metrikleri",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "single" } },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(http_requests_total{job=\"santis-api\"}[1m])",
        "legendFormat": "{{method}} {{handler}} {{status_code}}"
      }],
      "title": "İstek Oranı (req/s)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "red", "value": 1.0 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"santis-api\"}[5m]))",
        "legendFormat": "p95 yanıt süresi"
      }],
      "title": "API p95 Yanıt Süresi",
      "type": "gauge"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(http_requests_total{job=\"santis-api\",status_code=~\"5..\"}[5m])",
        "legendFormat": "5xx Hatalar"
      }],
      "title": "5xx Hata Oranı",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "📋 BullMQ Rezervasyon Kuyruğu",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "bull_queue_completed_total{queue=\"reservation\"}",
          "legendFormat": "✅ Tamamlanan"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "bull_queue_failed_total{queue=\"reservation\"}",
          "legendFormat": "❌ Başarısız"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "bull_queue_waiting{queue=\"reservation\"}",
          "legendFormat": "⏳ Bekleyen"
        }
      ],
      "title": "Rezervasyon Kuyruğu Durumu",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 11,
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "bull_queue_completed_total{queue=\"email\"}",
          "legendFormat": "✅ Gönderilen E-posta"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "bull_queue_failed_total{queue=\"email\"}",
          "legendFormat": "❌ Başarısız E-posta"
        }
      ],
      "title": "E-posta Kuyruğu Durumu",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "🗄️ Redis & Sistem",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "continuous-GrYlRd" } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 20,
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "redis_memory_used_bytes",
        "legendFormat": "Redis Bellek Kullanımı"
      }],
      "title": "Redis Bellek",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 21,
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(redis_commands_total[1m])",
        "legendFormat": "Redis Komut/s"
      }],
      "title": "Redis Operasyon Oranı",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 22,
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(nginx_http_requests_total[1m])",
        "legendFormat": "Nginx İstek/s"
      }],
      "title": "Nginx Trafik",
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["santis-os", "api", "bullmq"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Santis OS — Operasyon Kontrol Paneli",
  "uid": "santis-ops-v1",
  "version": 1
