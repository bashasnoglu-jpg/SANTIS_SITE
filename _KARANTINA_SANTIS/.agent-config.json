{
    "$schema": "https://example.local/agent-config.schema.json",
    "profile": "safe-dev",
    "profiles": {
        "safe-dev": {
            "strictMode": false,
            "artifactReviewPolicy": "ask_for_review",
            "terminal": {
                "autoExecution": "request_review",
                "shellIntegration": true,
                "allowList": [
                    "npm install",
                    "npm run dev",
                    "npm run build",
                    "npm start",
                    "node server.js",
                    "node build.mjs",
                    "pnpm install",
                    "pnpm dev",
                    "pnpm build",
                    "git status",
                    "git diff",
                    "git log",
                    "dir",
                    "ls",
                    "type",
                    "cat"
                ],
                "denyList": [
                    "rm",
                    "rm -r",
                    "rm -rf",
                    "del",
                    "del /s",
                    "Remove-Item",
                    "Remove-Item -Recurse",
                    "Remove-Item -Force",
                    "rd",
                    "rmdir",
                    "format",
                    "shutdown",
                    "restart",
                    "Stop-Process",
                    "taskkill",
                    "taskkill /f",
                    "net user",
                    "icacls",
                    "takeown",
                    "kill",
                    "taskkill node",
                    "Stop-Process node",
                    "del assets",
                    "rm assets",
                    "Remove-Item assets",
                    "del config",
                    "rm config",
                    "Remove-Item config"
                ]
            },
            "fileAccess": {
                "gitignoreAccess": false,
                "nonWorkspaceAccess": false,
                "autoOpenEditedFiles": true
            },
            "automation": {
                "autoFixLints": true,
                "autoContinue": true
            },
            "history": {
                "conversationHistory": true,
                "knowledge": true
            },
            "general": {
                "explainAndFixInCurrentConversation": true,
                "openAgentOnReload": false,
                "followAlongByDefault": true,
                "enableSoundsForAgent": false,
                "autoExpandChangesOverview": true
            }
        },
        "aggressive-dev": {
            "strictMode": false,
