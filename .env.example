# ╔══════════════════════════════════════════════════════╗
# ║  SANTIS OS — Environment Variables Template          ║
# ║  Faz 8 — Sovereign Security & Production Overrides  ║
# ╚══════════════════════════════════════════════════════╝

# ── Environment & App Target ─────────────────────────────────────────────────
SANTIS_ENV=development
SANTIS_API_APP=server:app

# ── Data Layer Configurations (Development Defaults) ─────────────────────────
DATABASE_URL=postgresql://santis:santis_dev_password@postgres:5432/santis
REDIS_URL=redis://redis:6379/0

# ── Security & Session Configurations ────────────────────────────────────────
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION HARDENING CHECKLIST:
#
# 1. Database & Cache Security:
#    - Replace 'santis_dev_password' with a strong, complex real DB password.
#    - Append real Redis password credentials to REDIS_URL in production.
#
# 2. Session Security:
#    - For production HTTPS environments, ALWAYS set:
#      SESSION_COOKIE_SECURE=true
#
# 3. Secrets Management:
#    - Do NOT commit the active '.env' file to the repository.
#    - Inject variables dynamically in production using Secret Manager
#      (e.g., AWS Secrets Manager, GCP Secret Manager) or GitHub Secrets in CI/CD.
# ──────────────────────────────────────────────────────────────────────────────
