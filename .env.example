# ╔══════════════════════════════════════════════════════╗
# ║  SANTIS OS — Environment Variables Template          ║
# ║  Faz 8 — Sovereign Security & Production Overrides  ║
# ╚══════════════════════════════════════════════════════╝

# ── Environment & App Target ─────────────────────────────────────────────────
SANTIS_ENV=development
SANTIS_API_APP=app.main:app

# ── Data Layer Persistence Configuration (DEV Defaults) ─────────────────────
# [DEV] Standard insecure local postgres and redis default configs.
# [PROD] Must be replaced with encrypted high-entropy connection strings.
DATABASE_URL=postgresql://santis:santis_dev_password@postgres:5432/santis
REDIS_URL=redis://redis:6379/0

# ── Security & Cryptography Secrets (PROD Only) ──────────────────────────────
# [PROD] Cryptographic JWT signing secret. Must be minimum 32 random characters.
# Injected via GCP Secret Manager or GitHub secrets. Do NOT hardcode!
SESSION_TOKEN_SECRET=santis_dev_session_token_cryptographic_secret_placeholder_32_chars

# ── Stripe Payment Gateway & Webhooks (PROD Only) ─────────────────────────────
# [PROD] API authorization and webhook signing secrets.
# Used for real-time Stripe webhooks and payment reconciliation.
STRIPE_API_KEY=sk_test_placeholder_key_never_commit_real_stripe_secrets
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# ── Session & Cookie Controls ────────────────────────────────────────────────
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ──────────────────────────────────────────────────────────────────────────────
# 🔒 SOVEREIGN DEV VS PROD SECRETS BOUNDARY:
#
# 1. Dev Variables (.env):
#    - Copied from '.env.example' to local '.env' for local developer loop.
#    - Session secure cookies remain disabled (HTTPS not enforced locally).
#
# 2. Production Secrets (Secret Manager / CI):
#    - Injected at runtime or deployment pipeline using environment variables.
#    - Never write or persist production secrets to disk inside the repository.
#    - Ensure SESSION_COOKIE_SECURE=true is enforced.
# ──────────────────────────────────────────────────────────────────────────────

